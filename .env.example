# Public site config (safe to expose). Contact links default to the values in
# src/data/site.ts; set these only to override.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKTREE_URL=
# Optional override for the Google Drive resume link (default is in src/data/site.ts)
NEXT_PUBLIC_RESUME_DRIVE_URL=

# Contact form (server-only) — https://resend.com
RESEND_API_KEY=
CONTACT_EMAIL=
FROM_EMAIL=

# Optional: authorized recommendations source returning
# [{ "quote": "...", "author": "...", "context": "..." }]
# Falls back to src/data/recommendations.json when unset or failing.
RECOMMENDATIONS_SOURCE_URL=
RECOMMENDATIONS_SOURCE_TOKEN=
